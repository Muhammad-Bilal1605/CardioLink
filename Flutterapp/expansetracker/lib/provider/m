  // Get base URL from config service (synchronous for compatibility)
  String get baseUrl => ConfigService.instance.baseUrl;

  // Set loading state
  void _setLoading(bool loading) {
    _isLoading = loading;
    notifyListeners();
  }

  // Set error message
  void _setError(String? error) {
    _errorMessage = error;
    notifyListeners();
  }

  // Clear error
  void clearError() {
    _errorMessage = null;
    notifyListeners();
  }

  // Set authentication token and update API service
  void _setAuthToken(String? token) {
    _authToken = token;
    
    // Always update the AppointmentApiService with current token
    if (token != null && token.isNotEmpty) {
      AppointmentApiService.setAuthToken(token);
      print('✓ Auth token set in AppointmentApiService (length: ${token.length})');
    } else {
      AppointmentApiService.clearAuthToken();
      print('✗ Auth token cleared from AppointmentApiService');
    }
  }

  // Clear all authentication data
  void clearAuth() {
    _currentUser = null;
    _userType = null;
    _setAuthToken(null); // This will also clear from AppointmentApiService
    _errorMessage = null;
    notifyListeners();
    print('✓ All authentication data cleared');
  }

  // PATIENT SIGNUP
  Future<bool> signup({
    required String email,
    required String password,
    required String name,
    String? phoneNumber,
    required String gender,
    int? age,
    DateTime? dateOfBirth,
    String? bloodType,
    List<String>? allergies,
    String? emergencyContact,
    List<Map<String, dynamic>>? medicalHistory,
    List<Map<String, dynamic>>? currentMedications,
  }) async {
    try {
      _setLoading(true);
      _setError(null);

      final currentBaseUrl = baseUrl;
      print('Starting patient signup process...');
      print('Email: $email');
      print('Name: $name');
      print('Using API URL: $currentBaseUrl');

      // Validate required fields
      if (age == null || age <= 0) {
        _setError('Age is required and must be valid');
        return false;
      }

      if (dateOfBirth == null) {
        _setError('Date of birth is required');
        return false;
      }

      if (phoneNumber == null || phoneNumber.isEmpty) {
        _setError('Phone number is required for patients');
        return false;
      }

      final requestData = {
        'email': email.trim(),
        'password': password,
        'name': name.trim(),
        'phoneNumber': phoneNumber.trim(),
        'gender': gender,
        'age': age,
        'dateOfBirth': dateOfBirth.toIso8601String(),
        'bloodType': bloodType,
        'allergies': allergies ?? [],
        'emergencyContact': emergencyContact?.trim(),
        'medicalHistory': medicalHistory ?? [],
        'currentMedications': currentMedications ?? [],
      };

      // Remove null values
      requestData.removeWhere((key, value) => value == null);

      final uri = Uri.parse('$currentBaseUrl/auth/patient/signup');
      print('Request URL: $uri');

      final response = await http.post(
        uri,
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: json.encode(requestData),
      ).timeout(const Duration(seconds: 30));

      print('Response status: ${response.statusCode}');
      print('Response body: ${response.body}');

      if (response.body.isEmpty) {
        print('Empty response body received');
        _setError('Server returned empty response');
        return false;
      }

      final responseData = json.decode(response.body);

      if (response.statusCode == 201 && responseData['success'] == true) {
        final userData = responseData['user'] ?? responseData['patient'];
        
        if (userData == null) {
          print('No user data in successful response');
          _setError('Invalid response format from server');
          return false;
        }

        _currentUser = userData;
        _userType = 'patient';
        
        // Set auth token from response
        final token = responseData['token'];
        if (token != null && token is String) {
          _setAuthToken(token);
        } else {
          print('Warning: No token received in signup response');
          _setAuthToken(null);
        }
        
        print('✓ Patient signup successful - User ID: ${userData['id']}');
        
        notifyListeners();
        return true;
      } else {
        final errorMsg = responseData['message'] ?? 'Patient signup failed';
        print('✗ Patient signup failed: $errorMsg');
        _setError(errorMsg);
        return false;
      }
    } catch (e) {
      print('✗ Patient signup exception: $e');
      _setError(_getNetworkErrorMessage(e));
      return false;
    } finally {
      _setLoading(false);
    }
  }

